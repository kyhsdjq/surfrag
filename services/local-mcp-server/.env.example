PORT=3030
DB_PATH=./data/surfrag.db

# Storage toggles (LightRAG is default, vector search is second choice)
# LIGHTRAG_INSERT_ENABLED=true
# LIGHTRAG_URL=http://localhost:9621
# LIGHTRAG_QUERY_ENABLED=true
# LIGHTRAG_API_KEY=

# SEARCH_CAPTURES_ENABLED=false (default). Set true to show search_captures MCP tool.
# SEARCH_CAPTURES_ENABLED=false

# VECTOR_DB_ENABLED=false (default). Set true + EMBED_API for vector search.
# VECTOR_SEARCH_ENABLED=false (default). Set true to show vector_search MCP tool.
# get_capture_by_id is only enabled when search_captures or vector_search is enabled.
# VECTOR_DB_ENABLED=false
# EMBED_API=
# EMBED_PROVIDER=glm
# EMBED_MODEL=embedding-2

# LLM_API_KEY, LLM_API_PROVIDER, LLM_MODEL are used for claim extraction and contradiction review.
# LLM_API_KEY=
# LLM_API_PROVIDER=glm
# LLM_MODEL=glm-4-flash
# MAX_DEBATE_ROUNDS=3
# VECTOR_DB_PATH=./data/lancedb