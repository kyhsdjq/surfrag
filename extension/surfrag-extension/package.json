{
  "name": "surfrag-extension",
  "displayName": "Surfrag extension",
  "version": "0.0.1",
  "description": "Captures pages to SurfRAG after engagement, bookmarks, or manual trigger.",
  "author": "kyhsdjq",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "bookmarks",
      "tabs"
    ],
    "commands": {
      "capture-page": {
        "suggested_key": {
          "default": "Ctrl+Shift+Y",
          "mac": "Command+Shift+Y"
        },
        "description": "Capture the current tab to SurfRAG"
      }
    },
    "host_permissions": [
      "<all_urls>"
    ]
  }
}
